# Copy to .env and fill in — .env is gitignored, this template is not.
# Never commit real keys.

# Supabase — create the project, then paste its values here.
# The anon key is safe to expose (it ships in the client bundle and every
# table is guarded by RLS), but keep it out of version control anyway.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Production origin — used by scripts/generate-sitemap.mjs and vite.config.ts
# to fill the absolute canonical/og:url tags. Leave blank locally; on Vercel it
# falls back to VERCEL_PROJECT_PRODUCTION_URL. Set it once the real domain is live.
SITE_URL=
